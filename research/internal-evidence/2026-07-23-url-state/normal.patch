+++ b/e2e/incident-board.spec.js
@@ -0,0 +1,89 @@
+"use strict";
+
+const { test, expect } = require("@playwright/test");
+const root = (process.env.BASE_URL || "http://127.0.0.1:4173").replace(/\/+$/, "");
+
+test("shares, restores, and operates the incident filters", async ({ page }) => {
+  const errors = [];
+  page.on("console", (message) => {
+    if (message.type() === "error") errors.push(message.text());
+  });
+  page.on("pageerror", (error) => errors.push(error.message));
+
+  const query = page.locator("#query");
+  const status = page.locator("#status");
+  const reset = page.locator("#reset");
+  const summary = page.locator("#summary");
+  const announcer = page.locator("#announcer");
+  const incidents = page.locator(".incident");
+
+  await page.goto(`${root}/?query=webhook&status=monitoring`);
+  await expect(query).toHaveValue("webhook");
+  await expect(status).toHaveValue("monitoring");
+  await expect(summary).toHaveText("1 of 5 incidents");
+  await expect(incidents).toHaveCount(1);
+  await expect(incidents.first()).toContainText("Delayed webhook delivery");
+  await expect(announcer).toHaveText("");
+
+  await query.fill("Checkout");
+  await status.selectOption("open");
+  await expect(summary).toHaveText("1 of 5 incidents");
+  await expect(incidents).toHaveCount(1);
+  await expect(announcer).toHaveText("1 of 5 incidents");
+  await expect.poll(() => new URL(page.url()).search).toBe("?query=Checkout&status=open");
+
+  await page.goto(`${root}/?status=not-a-status`);
+  await expect(status).toHaveValue("all");
+  await expect(summary).toHaveText("5 of 5 incidents");
+  await expect(page).toHaveURL(`${root}/`);
+
+  await page.goto(`${root}/?query=upload&status=open`);
+  await reset.click();
+  await expect(query).toHaveValue("");
+  await expect(status).toHaveValue("all");
+  await expect(summary).toHaveText("5 of 5 incidents");
+  await expect(page).toHaveURL(`${root}/`);
+
+  await page.goto(`${root}/`);
+  await page.evaluate(() => {
+    history.pushState(null, "", "?query=Search&status=resolved");
+    dispatchEvent(new PopStateEvent("popstate"));
+  });
+  await expect(query).toHaveValue("Search");
+  await expect(status).toHaveValue("resolved");
+  await query.fill("billing");
+  await expect.poll(() => new URL(page.url()).search).toBe("?query=billing&status=resolved");
+  await page.goBack();
+  await expect(query).toHaveValue("");
+  await expect(status).toHaveValue("all");
+  await expect(summary).toHaveText("5 of 5 incidents");
+  await page.goForward();
+  await expect(query).toHaveValue("billing");
+  await expect(status).toHaveValue("resolved");
+  await expect(summary).toHaveText("0 of 5 incidents");
+
+  await page.goto(`${root}/`);
+  await query.focus();
+  await page.keyboard.type("Checkout");
+  await expect(query).toBeFocused();
+  await page.keyboard.press("Tab");
+  await expect(status).toBeFocused();
+  await page.keyboard.press("ArrowDown");
+  await expect(status).toHaveValue("open");
+  await expect(summary).toHaveText("1 of 5 incidents");
+  await page.keyboard.press("Tab");
+  await expect(reset).toBeFocused();
+  await page.keyboard.press("Enter");
+  await expect(query).toHaveValue("");
+  await expect(status).toHaveValue("all");
+  await expect(page).toHaveURL(`${root}/`);
+
+  for (const viewport of [{ width: 1280, height: 800 }, { width: 320, height: 640 }]) {
+    await page.setViewportSize(viewport);
+    await page.goto(`${root}/?query=image&status=open`);
+    const noOverflow = await page.evaluate(() => document.documentElement.scrollWidth <= document.documentElement.clientWidth);
+    expect(noOverflow).toBe(true);
+  }
+
+  expect(errors).toEqual([]);
+});
