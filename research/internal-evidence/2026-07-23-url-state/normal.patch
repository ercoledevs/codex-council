diff --git a/state-codec.js b/state-codec.js
new file mode 100644
index 0000000..562bb56
--- /dev/null
+++ b/state-codec.js
@@ -0,0 +1,42 @@
+"use strict";
+
+(function (root, factory) {
+  const codec = factory();
+  if (typeof module === "object" && module.exports) module.exports = codec;
+  else root.IncidentStateCodec = codec;
+})(typeof globalThis === "object" ? globalThis : this, function () {
+  const statuses = Object.freeze(["all", "open", "monitoring", "resolved"]);
+  const knownStatuses = new Set(statuses);
+
+  function normalize(state = {}) {
+    const value = state && typeof state === "object" ? state : {};
+    return {
+      query: typeof value.query === "string" ? value.query : "",
+      status: knownStatuses.has(value.status) ? value.status : "all"
+    };
+  }
+
+  function decode(search = "") {
+    const params = new URLSearchParams(typeof search === "string" ? search : "");
+    return normalize({
+      query: params.get("query") ?? "",
+      status: params.get("status") ?? "all"
+    });
+  }
+
+  function encode(state = {}) {
+    const value = normalize(state);
+    const params = new URLSearchParams();
+    if (value.query.trim() !== "") params.set("query", value.query);
+    if (value.status !== "all") params.set("status", value.status);
+    const search = params.toString();
+    return search ? `?${search}` : "";
+  }
+
+  return Object.freeze({
+    STATUSES: statuses,
+    normalize,
+    decode,
+    encode
+  });
+});
