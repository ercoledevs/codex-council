diff --git a/test/state-codec.test.js b/test/state-codec.test.js
new file mode 100644
index 0000000..3b385f0
--- /dev/null
+++ b/test/state-codec.test.js
@@ -0,0 +1,32 @@
+"use strict";
+
+const test = require("node:test");
+const assert = require("node:assert/strict");
+const codec = require("../state-codec.js");
+
+test("normalizes missing and invalid state", () => {
+  assert.deepEqual(codec.normalize(null), { query: "", status: "all" });
+  assert.deepEqual(codec.normalize({ query: 7, status: "OPEN" }), { query: "", status: "all" });
+});
+
+test("decodes URL encoding and rejects unknown statuses", () => {
+  assert.deepEqual(
+    codec.decode("?query=Delayed+webhook&status=monitoring"),
+    { query: "Delayed webhook", status: "monitoring" }
+  );
+  assert.deepEqual(codec.decode("?status=closed"), { query: "", status: "all" });
+});
+
+test("encodes only non-default values", () => {
+  assert.equal(codec.encode({ query: "", status: "all" }), "");
+  assert.equal(codec.encode({ query: "   ", status: "all" }), "");
+  assert.equal(
+    codec.encode({ query: "billing totals", status: "resolved" }),
+    "?query=billing+totals&status=resolved"
+  );
+});
+
+test("round-trips arbitrary query text", () => {
+  const state = { query: `<img src=x onerror="boom">`, status: "open" };
+  assert.deepEqual(codec.decode(codec.encode(state)), state);
+});
