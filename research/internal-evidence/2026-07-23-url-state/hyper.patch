diff --git a/test/state-codec.test.js b/test/state-codec.test.js
new file mode 100644
index 0000000..703891d
--- /dev/null
+++ b/test/state-codec.test.js
@@ -0,0 +1,63 @@
+"use strict";
+
+const assert = require("node:assert/strict");
+const test = require("node:test");
+
+const {
+  VALID_STATUSES,
+  normalizeState,
+  decodeState,
+  encodeState,
+} = require("../state-codec");
+
+test("normalizes defaults and accepts only known statuses", () => {
+  assert.deepEqual(normalizeState(), { query: "", status: "all" });
+  for (const status of VALID_STATUSES) {
+    assert.deepEqual(normalizeState({ query: "q", status }), {
+      query: "q",
+      status,
+    });
+  }
+  assert.deepEqual(normalizeState({ query: 42, status: "OPEN" }), {
+    query: "",
+    status: "all",
+  });
+});
+
+test("decodes URL state and uses the first duplicate value", () => {
+  assert.deepEqual(
+    decodeState("?query=webhook+delivery&status=monitoring"),
+    { query: "webhook delivery", status: "monitoring" },
+  );
+  assert.deepEqual(
+    decodeState("?query=first&query=second&status=open&status=resolved"),
+    { query: "first", status: "open" },
+  );
+  assert.deepEqual(decodeState("?status=bogus"), {
+    query: "",
+    status: "all",
+  });
+});
+
+test("encodes only non-default values in canonical order", () => {
+  assert.equal(encodeState({ query: "", status: "all" }), "");
+  assert.equal(encodeState({ query: "   ", status: "all" }), "");
+  assert.equal(encodeState({ query: "checkout", status: "all" }), "query=checkout");
+  assert.equal(encodeState({ query: "", status: "open" }), "status=open");
+  assert.equal(
+    encodeState({ query: "billing totals", status: "resolved" }),
+    "query=billing+totals&status=resolved",
+  );
+  assert.equal(encodeState({ query: "", status: "unknown" }), "");
+});
+
+test("round-trips unicode and reserved query characters", () => {
+  for (const query of [
+    "caffè + tè",
+    "a&b/c?d=e",
+    "<img src=x onerror=alert(1)>",
+  ]) {
+    const state = { query, status: "monitoring" };
+    assert.deepEqual(decodeState(`?${encodeState(state)}`), state);
+  }
+});
