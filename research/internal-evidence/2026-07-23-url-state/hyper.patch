diff --git a/e2e/browser.cjs b/e2e/browser.cjs
new file mode 100644
index 0000000..09cdf49
--- /dev/null
+++ b/e2e/browser.cjs
@@ -0,0 +1,88 @@
+"use strict";
+
+const assert = require("node:assert/strict");
+const { chromium } = require("playwright");
+
+const baseUrl = (process.env.BASE_URL || "http://127.0.0.1:4173").replace(
+  /\/+$/,
+  "",
+);
+
+async function runViewport(browser, viewport) {
+  const page = await browser.newPage({ viewport });
+  const errors = [];
+  page.on("console", (message) => {
+    if (message.type() === "error") errors.push(message.text());
+  });
+  page.on("pageerror", (error) => errors.push(error.message));
+  page.on("requestfailed", (request) => {
+    errors.push(`${request.method()} ${request.url()} failed`);
+  });
+
+  await page.goto(`${baseUrl}/?query=webhook&status=monitoring`);
+  assert.equal(await page.locator("#query").inputValue(), "webhook");
+  assert.equal(await page.locator("#status").inputValue(), "monitoring");
+  assert.equal(await page.locator("#summary").textContent(), "1 of 5 incidents");
+  assert.equal(await page.locator(".incident").count(), 1);
+  assert.equal(await page.locator("#live-summary").textContent(), "");
+
+  await page.locator("#query").fill("Checkout");
+  await page.locator("#status").selectOption("open");
+  assert.equal(new URL(page.url()).search, "?query=Checkout&status=open");
+  assert.equal(await page.locator("#query").evaluate((node) => node === document.activeElement), false);
+
+  await page.locator("#query").focus();
+  await page.locator("#query").fill("   ");
+  assert.equal(new URL(page.url()).search, "?status=open");
+  assert.equal(
+    await page.locator("#query").evaluate((node) => node === document.activeElement),
+    true,
+  );
+
+  await page.goto(`${baseUrl}/?status=bogus`);
+  assert.equal(await page.locator("#status").inputValue(), "all");
+  assert.equal(new URL(page.url()).search, "");
+
+  await page.evaluate(() => {
+    history.pushState({ checkpoint: 1 }, "", "?query=checkout&status=open");
+    history.pushState({ checkpoint: 2 }, "", "?status=monitoring");
+    dispatchEvent(new PopStateEvent("popstate"));
+  });
+  await page.goBack();
+  assert.equal(await page.locator("#query").inputValue(), "checkout");
+  assert.equal(await page.locator("#status").inputValue(), "open");
+  await page.goForward();
+  assert.equal(await page.locator("#query").inputValue(), "");
+  assert.equal(await page.locator("#status").inputValue(), "monitoring");
+
+  await page.locator("#reset").focus();
+  await page.keyboard.press("Enter");
+  assert.equal(await page.locator("#query").inputValue(), "");
+  assert.equal(await page.locator("#status").inputValue(), "all");
+  assert.equal(new URL(page.url()).search, "");
+  assert.equal(
+    await page.locator("#reset").evaluate((node) => node === document.activeElement),
+    true,
+  );
+
+  const noOverflow = await page.evaluate(
+    () => document.documentElement.scrollWidth <= document.documentElement.clientWidth,
+  );
+  assert.equal(noOverflow, true);
+  assert.deepEqual(errors, []);
+  await page.close();
+}
+
+(async () => {
+  const browser = await chromium.launch({ headless: true });
+  try {
+    await runViewport(browser, { width: 1280, height: 800 });
+    await runViewport(browser, { width: 320, height: 640 });
+    process.stdout.write("browser checks: PASS\n");
+  } finally {
+    await browser.close();
+  }
+})().catch((error) => {
+  console.error(error);
+  process.exitCode = 1;
+});
