diff --git a/state-codec.js b/state-codec.js
new file mode 100644
index 0000000..4825df8
--- /dev/null
+++ b/state-codec.js
@@ -0,0 +1,55 @@
+"use strict";
+
+(function exposeStateCodec(root, factory) {
+  const codec = factory();
+  if (typeof module === "object" && module.exports) {
+    module.exports = codec;
+  } else {
+    root.IncidentStateCodec = codec;
+  }
+})(typeof globalThis === "object" ? globalThis : this, function createCodec() {
+  const VALID_STATUSES = Object.freeze([
+    "all",
+    "open",
+    "monitoring",
+    "resolved",
+  ]);
+  const statusSet = new Set(VALID_STATUSES);
+
+  function normalizeState(state) {
+    const input = state && typeof state === "object" ? state : {};
+    return {
+      query: typeof input.query === "string" ? input.query : "",
+      status: statusSet.has(input.status) ? input.status : "all",
+    };
+  }
+
+  function decodeState(search) {
+    const params = new URLSearchParams(
+      typeof search === "string" ? search : "",
+    );
+    return normalizeState({
+      query: params.get("query") ?? "",
+      status: params.get("status") ?? "all",
+    });
+  }
+
+  function encodeState(state) {
+    const normalized = normalizeState(state);
+    const params = new URLSearchParams();
+    if (normalized.query.trim() !== "") {
+      params.set("query", normalized.query);
+    }
+    if (normalized.status !== "all") {
+      params.set("status", normalized.status);
+    }
+    return params.toString();
+  }
+
+  return Object.freeze({
+    VALID_STATUSES,
+    normalizeState,
+    decodeState,
+    encodeState,
+  });
+});
