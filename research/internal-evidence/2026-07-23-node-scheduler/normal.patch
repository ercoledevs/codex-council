diff --git a/test/scheduler.test.js b/test/scheduler.test.js
index d46329c..a31660d 100644
--- a/test/scheduler.test.js
+++ b/test/scheduler.test.js
@@ -37,3 +37,131 @@ test("validates arguments", async () => {
   await assert.rejects(() => runJobs(null, async () => {}), /jobs must be an array/);
   await assert.rejects(() => runJobs([], null), /worker must be a function/);
 });
+
+function deferred() {
+  let resolve;
+  let reject;
+  const promise = new Promise((resolvePromise, rejectPromise) => {
+    resolve = resolvePromise;
+    reject = rejectPromise;
+  });
+  return { promise, resolve, reject };
+}
+
+test("bounds concurrency and preserves result order", async () => {
+  const gates = Array.from({ length: 4 }, () => deferred());
+  const starts = Array.from({ length: 4 }, () => deferred());
+  const calls = [];
+  let active = 0;
+  let maxActive = 0;
+
+  const resultPromise = runJobs(
+    [0, 1, 2, 3],
+    async (job) => {
+      calls.push(job);
+      active += 1;
+      maxActive = Math.max(maxActive, active);
+      starts[job].resolve();
+      try {
+        return await gates[job].promise;
+      } finally {
+        active -= 1;
+      }
+    },
+    { concurrency: 2 },
+  );
+
+  await Promise.all([starts[0].promise, starts[1].promise]);
+  assert.deepEqual(calls, [0, 1]);
+  gates[1].resolve("one");
+  await starts[2].promise;
+  gates[0].resolve("zero");
+  await starts[3].promise;
+  gates[2].resolve("two");
+  gates[3].resolve("three");
+
+  assert.deepEqual(await resultPromise, [
+    { status: "fulfilled", value: "zero" },
+    { status: "fulfilled", value: "one" },
+    { status: "fulfilled", value: "two" },
+    { status: "fulfilled", value: "three" },
+  ]);
+  assert.equal(maxActive, 2);
+});
+
+test(
+  "retries failed and timed-out attempts and handles late rejection",
+  { timeout: 1_000 },
+  async () => {
+    const late = deferred();
+    const seen = [];
+    const result = await runJobs(
+      ["failure", "timeout"],
+      (job, index, { attempt, signal }) => {
+        seen.push(`${job}:${index}:${attempt}:${signal.aborted}`);
+        if (job === "failure" && attempt === 1) throw new Error("retry");
+        if (job === "timeout" && attempt === 1) return late.promise;
+        return `${job}-done`;
+      },
+      { maxRetries: 1, timeoutMs: 10 },
+    );
+
+    assert.deepEqual(result, [
+      { status: "fulfilled", value: "failure-done" },
+      { status: "fulfilled", value: "timeout-done" },
+    ]);
+    assert.deepEqual(seen, [
+      "failure:0:1:false",
+      "failure:0:2:false",
+      "timeout:1:1:false",
+      "timeout:1:2:false",
+    ]);
+    late.reject(new Error("late rejection"));
+    await new Promise((resolve) => setImmediate(resolve));
+  },
+);
+
+test("caller abort stops launches and rejects queued jobs", async () => {
+  const controller = new AbortController();
+  const started = [];
+  const signals = [];
+  const resultPromise = runJobs(
+    [0, 1, 2, 3],
+    (job, index, { signal }) => {
+      started.push(job);
+      signals.push(signal);
+      return new Promise(() => {});
+    },
+    { concurrency: 2, signal: controller.signal },
+  );
+
+  assert.deepEqual(started, [0, 1]);
+  controller.abort(new Error("caller-specific reason"));
+  const result = await resultPromise;
+  assert.ok(signals.every((signal) => signal.aborted));
+  assert.deepEqual(
+    result,
+    Array.from({ length: 4 }, () => ({
+      status: "rejected",
+      reason: "Job aborted",
+    })),
+  );
+});
+
+test("invalid options fail before workers start", async () => {
+  let calls = 0;
+  for (const options of [
+    null,
+    { concurrency: 0 },
+    { maxRetries: -1 },
+    { timeoutMs: 0 },
+    { signal: {} },
+  ]) {
+    await assert.rejects(() =>
+      runJobs([1], () => {
+        calls += 1;
+      }, options),
+    );
+  }
+  assert.equal(calls, 0);
+});
